rectangle "Dispositivo del usuario\n<size:16>[Deployment Node: Android / navegador web]</size>" <<DeploymentNode-RWxlbWVudA==>> as Producción.Dispositivodelusuario {
  rectangle "==PWA móvil\n<size:16>[Container: HTML5, TailwindCSS, JavaScript, Service Worker]</size>\n\nInterfaz instalable y responsiva para clientes, comerciantes, repartidores y administradores; tolera conectividad intermitente." <<Element-RWxlbWVudCxDb250YWluZXIsV2ViIEJyb3dzZXI=>> as Producción.Dispositivodelusuario.PWAmóvil_1
}

rectangle "VPS de bajo costo\n<size:16>[Deployment Node: Ubuntu 24.04, 2 vCPU, 4 GB RAM]</size>" <<DeploymentNode-RWxlbWVudA==>> as Producción.VPSdebajocosto {
  rectangle "Docker Compose\n<size:16>[Deployment Node: Docker Compose]</size>" <<DeploymentNode-RWxlbWVudA==>> as Producción.VPSdebajocosto.DockerCompose {
    rectangle "==API San Camilo\n<size:16>[Container: Python, FastAPI o Django, REST/JSON]</size>\n\nMonolito modular que expone los casos de uso mediante una API REST y mantiene fronteras de dominio explícitas." <<Element-RWxlbWVudCxDb250YWluZXI=>> as Producción.VPSdebajocosto.DockerCompose.APISanCamilo_1
    hexagon "==Worker de notificaciones\n<size:16>[Container: Celery]</size>\n\nConsume avisos pendientes y aplica reintentos sin bloquear la confirmación del pedido." <<Element-RWxlbWVudCxDb250YWluZXIsV29ya2Vy>> as Producción.VPSdebajocosto.DockerCompose.Workerdenotificaciones_1
    database "==PostgreSQL\n<size:16>[Container: PostgreSQL 15+]</size>\n\nPersistencia ACID con esquemas lógicos aislados: catalogo, pedidos, pagos, notificaciones y usuarios." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as Producción.VPSdebajocosto.DockerCompose.PostgreSQL_1
    queue "==Redis\n<size:16>[Container: Redis]</size>\n\nCaché del catálogo y cola de tareas de notificación." <<Element-RWxlbWVudCxDb250YWluZXIsUXVldWU=>> as Producción.VPSdebajocosto.DockerCompose.Redis_1
  }

}

